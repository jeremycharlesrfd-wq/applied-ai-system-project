# Copy this file to ".env" and fill in your key to enable the AI (RAG) explanation.
#   cp .env.example .env
#
# Without a key the app still runs — it falls back to a deterministic, template-based
# explanation built from the same retrieved song rows (see src/rag.py).
ANTHROPIC_API_KEY=

# Optional: override the model used for the grounded explanation (default: claude-opus-4-8).
# RECOMMENDER_MODEL=claude-opus-4-8